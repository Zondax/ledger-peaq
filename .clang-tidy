# portability-avoid-pragma-once is off on purpose: `#pragma once` is the
# convention across this app, deps/ledger-zxlib and the Ledger secure SDK,
# and deps/ is outside the lint scope, so converting only app/src would
# leave the tree inconsistent for no portability gain (gcc/clang only).
Checks: "-*,
  clang-diagnostic-*,
  clang-analyzer-*,
  cppcoreguidelines-init-variables,
  google-runtime-int,
  google-readability-avoid-underscore-in-googletest-name,
  misc-*,
  -misc-include-cleaner,
  performance-*,
  portability-*,
  -portability-avoid-pragma-once,
  readability-*,
  -misc-no-recursion,
  -readability-function-cognitive-complexity,
  -readability-magic-numbers"
WarningsAsErrors: "*"
CheckOptions:
  - key: readability-identifier-length.MinimumVariableNameLength
    value: 1
  - key: readability-identifier-length.MinimumParameterNameLength
    value: 1
  - key: readability-identifier-length.MinimumLoopCounterNameLength
    value: 1
  - key: readability-magic-numbers.IgnorePowersOf2IntegerValues
    value: true
